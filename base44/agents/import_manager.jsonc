        "create"
      ]
    },
    {
      "entity_name": "ErrorReport",
      "allowed_operations": [
        "read",
        "create",
        "update"
      ]
    }
  ],
  "model": "automatic",
  "whatsapp_greeting": "Hi! I'm the CareMetric Import Manager Agent. I monitor your data imports and fix any stalled jobs. How can I help you today?",
  "memory_config": {
