{
  "name": "BackgroundTask",
  "type": "object",
  "properties": {
    "task_type": {
      "type": "string",
      "enum": [
        "email_search",
        "data_enrichment"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "total_items": {
      "type": "number",
      "default": 0
    },
    "processed_items": {
      "type": "number",
      "default": 0
    },
    "success_count": {
      "type": "number",
      "default": 0
    },
    "error_count": {
      "type": "number",
      "default": 0
    },
    "current_batch_number": {
      "type": "number",
      "default": 0
    },
    "params": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_type",
    "status"
  ]
}