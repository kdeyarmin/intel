{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "import",
        "export",
        "scoring_run",
        "user_action"
      ],
      "description": "Type of event"
    },
    "user_email": {
      "type": "string",
      "description": "User who triggered the event"
    },
    "details": {
      "type": "object",
      "description": "Event details (JSON)",
      "properties": {
        "action": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "row_count": {
          "type": "number"
        },
        "file_name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "user_email"
  ]
}