# CareMetric Intel — environment configuration
# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# Only DATABASE_URL is required to boot in development; production additionally
# requires JWT_SECRET (the server refuses to start without it).

# ─── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string used by Drizzle / the pg pool.
DATABASE_URL=postgresql://user:password@host:5432/caremetric
# Max connections in the pool (default 30).
DB_POOL_MAX=30
# Apply drizzle/ migrations at start-up, before the server listens (default
# off; `npm run db:migrate` does the same by hand). Safe with several instances:
# an advisory lock lets only one migrate at a time.
DB_MIGRATE_ON_BOOT=false
# Census geography (counties, ZIP areas) loads from server/data/census at
# start-up when the tables are empty or the bundled data changed. Set to false
# to skip that and load it yourself with `npm run geo:load`.
GEO_AUTOLOAD=true

# ─── Runtime ──────────────────────────────────────────────────────────────────
# "production" or "development". Affects cookie security, CORS enforcement,
# admin-seed behavior, and whether internal error details are returned.
NODE_ENV=development
# API server port (PORT takes precedence, then API_PORT, default 3001).
PORT=3001

# ─── Auth (JWT_SECRET required in production) ─────────────────────────────────
# Secret used to sign session JWTs. REQUIRED in production — the server throws
# on startup if unset. In development an ephemeral random secret is generated
# (sessions drop on restart). Use a long random string.
JWT_SECRET=

# First-admin seed. In production the admin is only seeded if ADMIN_PASSWORD is
# set; in development a non-secret placeholder password is used if unset.
# Signup refuses ADMIN_EMAIL. If nobody can administer the app, the account is
# restored to an active admin at start-up only while its password still equals
# ADMIN_PASSWORD; otherwise use `RECOVER_EMAIL=... npx tsx scripts/admin-recover.ts`.
ADMIN_EMAIL=admin@caremetric.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=CareMetric Admin

# Which X-Forwarded-For hops to trust for client IPs (login throttles, audit).
# Unset keeps the left-most forwarded address, which a client can forge. Set
# the number of proxies in front of the app (e.g. 1), "false" when it is
# reached directly, or a list of proxy IPs/CIDRs.
TRUST_PROXY=

# Optional live Base44 Hub bridge. Configure only as hosted function secrets;
# these do not activate the Express backend or grant native administrator roles.
# CAREMETRIC_ADMIN_ENABLED=false
# CAREMETRIC_ADMIN_IDENTITY_MAP_JSON=<reviewed Hub UUID to native Base44 user ID map>
# CAREMETRIC_ADMIN_SOURCE_REVISION=<exact deployed 40-character commit>

# ─── CORS (production) ────────────────────────────────────────────────────────
# Comma-separated list of extra browser origins allowed to call the API, enforced
# only in production. The API's own origin is always allowed, so leave it unset
# when the SPA is served by the API (a separate frontend domain goes here).
ALLOWED_ORIGINS=

# ─── Anthropic / Claude (required for AI features) ────────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides — roll out model upgrades without a code change.
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001
CLAUDE_MODEL_OPUS=claude-opus-4-7
# The AI Assistant page (server/lib/assistant). An override must support
# streaming tool use, adaptive thinking, effort and server-side fallback.
CLAUDE_MODEL_ASSISTANT=claude-opus-5-5
# low | medium | high | xhigh | max (default medium).
ASSISTANT_EFFORT=medium
# Per user: questions per minute, token units per UTC day (input + cache
# writes + output + a tenth of cache reads), and questions per conversation.
ASSISTANT_REQUESTS_PER_MINUTE=6
ASSISTANT_DAILY_TOKEN_BUDGET=1000000
ASSISTANT_MAX_TURNS=40

# ─── Maintenance / scheduled imports ──────────────────────────────────────────
# Shared secret for the unauthenticated maintenance endpoints under
# /api/maintenance/* (runScheduledImports, autoRetryFailedImports,
# autoResumePausedImports, cancelStalledImports). Point an external scheduler
# (e.g. a Railway cron job or system cron) at
#   POST /api/maintenance/runScheduledImports
# with header `x-maintenance-token: <this value>` every ~10 minutes
# (scripts/maintenance-tick.sh does exactly that). If unset, these endpoints
# are reachable only by an authenticated admin (no cron access).
MAINTENANCE_TOKEN=
# Hosts without an external scheduler can tick from inside the server instead:
# the same work every N milliseconds (minimum 60000), shared across instances
# with an advisory lock. Leave unset when a cron is wired.
# MAINTENANCE_INPROCESS_INTERVAL_MS=600000

# ─── Email / SendGrid (required to send email) ────────────────────────────────
SENDGRID_API_KEY=
# Default + primary allowed sender address.
SENDGRID_FROM_EMAIL=noreply@caremetric.com
# Optional extra comma-separated sender addresses the /email/send endpoint may
# use. A caller-supplied "from" is honored only if it is on this allowlist;
# otherwise it falls back to SENDGRID_FROM_EMAIL (prevents open relay/spoofing).
ALLOWED_FROM_EMAILS=
# Development only: MAIL_TRANSPORT=outbox writes every email (reset and invite
# links, campaigns, reports) to MAIL_OUTBOX_PATH as JSON lines instead of
# sending it. Refused when NODE_ENV=production.
# MAIL_TRANSPORT=outbox
# MAIL_OUTBOX_PATH=.data/mail-outbox.jsonl

# ─── Outreach email (required to send campaigns or direct emails) ────────────
# Outreach emails (campaigns, and direct emails from a provider's profile) must
# carry a postal address and a working unsubscribe link (CAN-SPAM). Sending
# stays disabled until both of these are set.
OUTREACH_PHYSICAL_ADDRESS=
# Public base URL of this app, used to build links in emails (unsubscribe,
# password reset, invites, approval notices). Required in production for reset
# and invite links; they are never built from the request's Host header.
PUBLIC_APP_URL=https://app.example.com
# Optional: secret for signing unsubscribe links (defaults to one derived from
# JWT_SECRET). Changing it invalidates links in emails already sent.
UNSUBSCRIBE_SECRET=
# SendGrid Event Webhook verification key (Settings → Mail Settings → Event
# Webhook → enable Signed Event Webhook). Point the webhook at
#   POST <PUBLIC_APP_URL>/api/webhooks/sendgrid
# Without it, opens/clicks/bounces aren't tracked; only sends are counted.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# ─── Operations alerts ───────────────────────────────────────────────────────
# Each maintenance tick emails the platform admins a digest (at most daily)
# when a dataset is behind a newer release for a week, a schedule keeps
# failing, a rollup is stale or a worker fails. Extra recipients, comma-separated:
OPERATIONS_ALERT_EMAILS=

# ─── Billing / Stripe (required to sell subscriptions) ───────────────────────
# Each signup creates an organization in a 14-day trial; owners choose a plan on
# the Billing page (Stripe Checkout) and manage payment in the customer portal.
# Without these, the Billing page shows the plans and says to contact you.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at
#   POST <PUBLIC_APP_URL>/api/webhooks/stripe
# (events: checkout.session.completed, customer.subscription.created/updated/
# deleted, invoice.paid, invoice.payment_failed).
STRIPE_WEBHOOK_SECRET=
# Stripe price ids per plan code, unless set in the plans table
# (plans.stripe_price_id): county_pack, state, national.
STRIPE_PRICE_COUNTY_PACK=
STRIPE_PRICE_STATE=
STRIPE_PRICE_NATIONAL=

# ─── Scheduled reports ────────────────────────────────────────────────────────
# Reports are emailed only to app users. List extra domains (comma-separated)
# whose addresses may also receive them, e.g. "caremetricintel.com,partner.org".
REPORT_RECIPIENT_DOMAINS=

# Where the NPPES dissemination zips are downloaded (default: ./downloads/nppes).
# Must be outside ./uploads, which is served to signed-in users.
# NPPES_DOWNLOAD_DIR=
